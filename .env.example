# Public Agent Market discovery does not require a credential.
NEAR_MARKET_BASE_URL=https://market.near.ai

# Optional live x402 buyer configuration. No defaults are enabled.
# NEAR's current Agent Payments guidance describes USDC buyer payment over Base,
# Polygon and Arbitrum. Configure only the official USDC contract verified for
# the selected chain. These examples are documentation only; uncomment only
# after your operator independently verifies the token contract and deploys
# a reviewed wallet adapter.
# X402_ALLOWED_NETWORKS=eip155:8453
# X402_ALLOWED_ASSETS_JSON={"eip155:8453":["0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"]}
X402_ALLOWED_NETWORKS=
X402_ALLOWED_ASSETS_JSON={}
X402_ASSET_DECIMALS=6
X402_MAX_PAYMENT_USD=5
# Local module/package only; it must export createSigner({ config }).
# No wallet adapter is included in this repository.
X402_WALLET_ADAPTER_MODULE=

# NEAR Intents Agent API (experimental). This is a separate integration,
# not a generic x402 wallet signer. Server-side only.
NEAR_INTENTS_AGENT_API_URL=https://api.agentsonintents.com
NEAR_INTENTS_AGENT_API_KEY=
NEAR_INTENTS_AGENT_ID=
# Store grant tokens in an encrypted server-side secret store; never commit them.

# Sponsored no-signup demo credits (simulation only)
DEMO_CREDIT_POOL_USD=1000
DEMO_CREDIT_PER_IP_USD=10
DEMO_CREDIT_PER_PROJECT_USD=5
DEMO_CREDIT_LEDGER_PATH=./data/demo-credit-ledger.json
# Set a random secret (32+ chars) in production; never commit it.
DEMO_CREDIT_IP_SECRET=replace-with-a-long-random-secret-before-deployment
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Persistent project session store (single-process local JSON; not shared between instances).
# Checkpoint 14 browser resume stores only the last project ID locally; this TTL still applies.
SESSION_STORE_PATH=./data/sessions.json
SESSION_TTL_MS=21600000
SESSION_MAX=2000

# Anonymous browser capability identity (not verified account authentication)
PRINCIPAL_STORE_PATH=./data/principals.json
PRINCIPAL_TTL_MS=2592000000
PRINCIPAL_MAX=20000
