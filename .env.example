# WorkRelay demo configuration. Payments are disabled: leave every X402_* variable unset.

# Public Agent Market discovery does not require a credential.
NEAR_MARKET_BASE_URL=https://market.near.ai

# Sponsored no-signup demo credits (simulation only)
DEMO_CREDIT_POOL_USD=1000
DEMO_CREDIT_PER_IP_USD=10
DEMO_CREDIT_PER_PROJECT_USD=5
DEMO_CREDIT_LEDGER_PATH=./data/demo-credit-ledger.json
# Required in production: a random secret of 32+ characters (for example `openssl rand -hex 32`). Never commit it.
DEMO_CREDIT_IP_SECRET=
# Set to true only behind a trusted HTTPS proxy that sets X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=false

# Single-process local JSON stores (not shared between instances)
SESSION_STORE_PATH=./data/sessions.json
PRINCIPAL_STORE_PATH=./data/principals.json
EXECUTION_LEDGER_DIR=./data/executions
