{
  "name": "workrelay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous contractor orchestration for the NEAR Agent Economy",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "discover": "node scripts/discover-agents.mjs",
    "test": "node --test",
